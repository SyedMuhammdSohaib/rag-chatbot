# Everything works with these defaults. You normally don't need to edit this.

# ollama = local (default). groq = free hosted API, needs GROQ_API_KEY.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:1b

# only if LLM_PROVIDER=groq  (free key: https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-20b
# tried in order when the main model hits the free limit (each has its own quota)
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b
# OPTIONAL second free provider with its own separate limits (recommended):
# free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.8-flash,gemini-2.5-flash
# if every online model is out of quota, use local Ollama when it is running
FALLBACK_TO_OLLAMA=true

LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4
# fewer/shorter old messages per question = fewer tokens = fewer rate limits
HISTORY_MESSAGES=6
HISTORY_MESSAGE_CHARS=1200
MAX_ANSWER_TOKENS=1024
